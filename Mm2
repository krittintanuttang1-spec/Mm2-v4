   Name = "เปิด/ปิด วงกลมกลางจอ (FOV)",
   CurrentValue = false,
   Callback = function(Value)
      FOVDrawing.Visible = Value
   end,
})

VisualTab:CreateSlider({
   Name = "ขนาดวงกลม FOV",
   Range = {50, 400},
   Increment = 10,
   CurrentValue = 150,
   Callback = function(Value)
      fovRadius = Value
      FOVDrawing.Radius = Value
   end,
})

CombatTab:CreateToggle({
   Name = "Aimbot ล็อกหัวออโต้",
   CurrentValue = false,
   Callback = function(Value)
      aimbot = Value
   end,
})

RunService.RenderStepped:Connect(function()
    pcall(function()
        FOVDrawing.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        if aimbot then
            local target, shortest = nil, fovRadius
            local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                    local hum = p.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - centerScreen).Magnitude
                            if dist < shortest then
                                shortest = dist
                                target = p
                            end
                        end
                    end
                end
            end
            
            if target and target.Character:FindFirstChild("Head") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
            end
        end
    end)
end)

-- ระบบดีดแบบพุ่งชนตัวเป้าหมายโดยตรง (Collision Fling)
local function collisionFling(roleName)
    pcall(function()
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar and myChar:FindFirstChild("Humanoid")
        if not myRoot or not myHum then return end
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if getRole(p) == roleName then
                    local targetRoot = p.Character.HumanoidRootPart
                    myHum.PlatformStand = true
                    
                    local startTime = tick()
                    local flingConnection
                    flingConnection = RunService.RenderStepped:Connect(function()
                        if tick() - startTime < 3 and targetRoot and myRoot then
                            -- เอาตัวเราไปประกบชนและหมุนเหวี่ยงด้วยความเร็วสูงเพื่อดันเป้าหมายให้กระเด็นตกแมพ
                            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 0)
                            myRoot.Velocity = Vector3.new(30000, 30000, 30000)
                            myRoot.RotVelocity = Vector3.new(99999, 99999, 99999)
                        else
                            myHum.PlatformStand = false
                            myRoot.Velocity = Vector3.new(0, 0, 0)
                            myRoot.RotVelocity = Vector3.new(0, 0, 0)
                            flingConnection:Disconnect()
                        end
                    end)
                end
            end
        end
    end)
end

CombatTab:CreateButton({
   Name = "ดีดฆาตกรออกแมพ (พุ่งชนกระเด็น)",
   Callback = function() collisionFling("Murderer") end,
})

CombatTab:CreateButton({
   Name = "ดีดนายอำเภอออกแมพ (พุ่งชนกระเด็น)",
   Callback = function() collisionFling("Sheriff") end,
})

-- ออโต้ฆ่าคน (วาร์ปเหยื่อมาข้างหน้า)
local autoKill = false
CombatTab:CreateToggle({
   Name = "ออโต้ฆ่าคน (วาร์ปเหยื่อมาข้างหน้า)",
   CurrentValue = false,
   Callback = function(Value) autoKill = Value end,
})

task.spawn(function()
    while true do
        task.wait(0.2)
        pcall(function()
            if autoKill and getRole(LocalPlayer) == "Murderer" then
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local hum = p.Character:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 and getRole(p) ~= "Murderer" then
                                p.Character.HumanoidRootPart.CFrame = myChar.HumanoidRootPart.CFrame + (myChar.HumanoidRootPart.CFrame.LookVector * 3)
                            end
                        end
                    end
                end
            end
        end)
    end
end)

