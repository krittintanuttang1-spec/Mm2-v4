-- ฟังก์ชันเช็คบทบาท MM2
local function getRole(p)
    if not p or not p.Character then return "Innocent" end
    local backpack = p:FindFirstChild("Backpack")
    local char = p.Character
    local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
    local hasGun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")))
    if hasKnife then return "Murderer"
    elseif hasGun then return "Sheriff"
    else return "Innocent" end
end

-- ==========================================
-- 1. Main & Movement Tab (ระบบบินบังคับทิศทางลื่นไหล)
-- ==========================================

local flyEnabled = false
local flySpeed = 50
local flyConn
local bv, bg

MainTab:CreateSlider({
   Name = "ความเร็วบิน (Fly Speed)",
   Range = {10, 300},
   Increment = 5,
   CurrentValue = 50,
   Callback = function(Value)
      flySpeed = Value
   end,
})

MainTab:CreateToggle({
   Name = "เปิด/ปิด บิน (Fly)",
   CurrentValue = false,
   Callback = function(Value)
      flyEnabled = Value
      pcall(function()
          local char = LocalPlayer.Character
          local hrp = char and char:FindFirstChild("HumanoidRootPart")
          local hum = char and char:FindFirstChild("Humanoid")
          if flyEnabled and hrp and hum then
              hum.PlatformStand = true
              bv = Instance.new("BodyVelocity")
              bv.MaxForce = Vector3.new(99999, 99999, 99999)
              bv.Velocity = Vector3.new(0, 0, 0)
              bv.Parent = hrp
              
              bg = Instance.new("BodyGyro")
              bg.MaxTorque = Vector3.new(99999, 99999, 99999)
              bg.CFrame = hrp.CFrame
              bg.Parent = hrp
              
              flyConn = RunService.RenderStepped:Connect(function()
                  if flyEnabled and hrp and hum and hum.Health > 0 then
                      bg.CFrame = Camera.CFrame
                      local moveDir = Vector3.new(0, 0, 0)
                      local camCF = Camera.CFrame
                      
                      if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                          moveDir = moveDir + camCF.LookVector
                      end
                      if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                          moveDir = moveDir - camCF.LookVector
                      end
                      if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                          moveDir = moveDir - camCF.RightVector
                      end
                      if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                          moveDir = moveDir + camCF.RightVector
                      end
                      
                      bv.Velocity = moveDir * flySpeed
                  else
                      if hum then hum.PlatformStand = false end
                      if bv then bv:Destroy() end
                      if bg then bg:Destroy() end
                      if flyConn then flyConn:Disconnect() end
                  end
              end)
          else
              if hum then hum.PlatformStand = false end
              if bv then bv:Destroy() end
              if bg then bg:Destroy() end
              if flyConn then flyConn:Disconnect() end
          end
      end)
   end,
})

